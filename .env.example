# Google Gemini API Key for Tia Voice Assistant (Native Google Search grounding and conversational intelligence)
GEMINI_API_KEY=

# Supabase Authentication & Database Integration
# Configure your Supabase project credentials:
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Premium Voice Engine (Optional: 'browser' [default], 'gemini', or 'google-cloud')
TTS_PROVIDER=browser
TTS_VOICE_ID=Aoede
# Optional: Google Cloud API Key if using Google Cloud Text-to-Speech Chirp 3 HD directly
GOOGLE_CLOUD_TTS_API_KEY=
